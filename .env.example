# Environment for the Python DEX alert bot.
#
# Copy to .env for local work, or install as an EnvironmentFile= for the systemd unit.
# Never commit the filled-in copy. Every variable the code reads is listed here; the
# only module allowed to read the environment is alert_bot/config.py.
#
# Values shown after "default:" are what the bot uses when the variable is unset. An
# invalid number silently falls back to its default (ported from the legacy config.num).

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# SECRET. Bot API token from @BotFather.
TELEGRAM_TOKEN=

# SECRET. Connection string; must start with mongodb:// or mongodb+srv://.
# The same database the legacy Node.js bot uses — schema is shared during dual run.
MONGO_URI=mongodb://localhost:27017/dexalerts

# ---------------------------------------------------------------------------
# Update delivery
# ---------------------------------------------------------------------------

# webhook (production) or polling (local development, no public URL needed).
# default: webhook
BOT_MODE=webhook

# Public HTTPS URL Telegram calls. nginx on the same host terminates TLS and proxies it
# to WEBHOOK_HOST:WEBHOOK_PORT — see PLAN.md §9.1. Required when BOT_MODE=webhook.
WEBHOOK_URL=https://dex-alert-bot.duckdns.org/webhook-v2

# SECRET. Sent to Telegram with setWebhook and verified on every inbound request via
# the x-telegram-bot-api-secret-token header. Required when BOT_MODE=webhook.
# The legacy bot only verified it and never registered it — see PLAN.md §6.1.
WEBHOOK_SECRET=

# Interface the webhook listener binds to. nginx always terminates TLS in front of the
# bot, so nothing but the proxy needs to reach it. default: 127.0.0.1
WEBHOOK_HOST=127.0.0.1

# Local port for the webhook listener. The legacy Node.js bot holds 3000 on the same
# host. default: 3001
WEBHOOK_PORT=3001

# Path component of WEBHOOK_URL. A leading slash is added if missing. Must match the
# nginx location. default: /webhook-v2
WEBHOOK_PATH=/webhook-v2

# ---------------------------------------------------------------------------
# Telegram sending
# ---------------------------------------------------------------------------

# Comma-separated chat ids permitted to use /admin. Parsed once at startup.
# default: empty (no admins)
ADMIN_CHAT_IDS=

# Delay between two queued outbound messages, in milliseconds (~28 msg/s at 35).
# The legacy bot parsed this variable and then ignored it. default: 35
TG_QUEUE_DELAY_MS=35

# Bot API host. Change only for a self-hosted Bot API server.
# default: https://api.telegram.org
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ---------------------------------------------------------------------------
# MongoDB tuning (defaults match the legacy client options)
# ---------------------------------------------------------------------------

# Overrides the database name embedded in MONGO_URI. default: empty (use the URI's)
MONGO_DB_NAME=

# Connection pool bounds. defaults: 10 / 1
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1

# Timeouts in milliseconds. defaults: 5000 / 45000 / 10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Price polling
# ---------------------------------------------------------------------------

# DexScreener host. default: https://api.dexscreener.com
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# Pause between the end of one price cycle and the start of the next, in milliseconds.
# default: 20000
DEX_CYCLE_INTERVAL_MS=20000

# Token addresses per DexScreener batch request; the API caps this at 30. default: 30
DEX_BATCH_SIZE=30

# Pause between two batch requests within one cycle, in milliseconds. default: 1000
DEX_BATCH_DELAY_MS=1000

# Optional comma-separated allow-list of chain ids (e.g. ethereum,bsc,solana).
# default: empty — accept whatever chain DexScreener reports, as the legacy bot does.
ENABLED_CHAINS=

# ---------------------------------------------------------------------------
# Outbound HTTP policy
# ---------------------------------------------------------------------------

# Per-request timeout in milliseconds. default: 15000
HTTP_TIMEOUT_MS=15000

# Total attempts per request, first try included. default: 3
HTTP_RETRY_ATTEMPTS=3

# Initial backoff between attempts, doubling each time, in milliseconds. default: 2000
HTTP_RETRY_BACKOFF_MS=2000

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

# Tracked tokens allowed per subscription tier. defaults: 5 / 15 / 50
SUBSCRIPTION_LIMIT_BASIC=5
SUBSCRIPTION_LIMIT_PRO=15
SUBSCRIPTION_LIMIT_PREMIUM=50

# Command rate limit per chat: how many commands within the window.
# defaults: 10 per 60000 ms
RATE_LIMIT_COMMANDS=10
RATE_LIMIT_WINDOW_MS=60000

# Idle timeout for a multi-step command flow, in milliseconds. default: 1800000 (30 min)
SESSION_TTL_MS=1800000

# How often expired flows are swept, in milliseconds. default: 300000 (5 min)
SESSION_CLEANUP_INTERVAL_MS=300000

# Lifetime of the in-memory blocked-user cache, in milliseconds. Minimum 60000.
# Used by the legacy bot but absent from its .env.template. default: 300000
BLOCKED_USERS_CACHE_TTL_MS=300000

# Active-user count above which /broadcast refuses to run. default: 1000
BROADCAST_MAX_USERS=1000

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------

# Logging verbosity: DEBUG, INFO, WARNING, ERROR. default: INFO
LOG_LEVEL=INFO

# How long shutdown waits for the outbound queue to drain before exiting anyway,
# in milliseconds. default: 5000
SHUTDOWN_DRAIN_TIMEOUT_MS=5000

# Free-form label used in logs to tell deployments apart. default: production
ENV_NAME=production
